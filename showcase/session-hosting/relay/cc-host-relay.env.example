# Generate a random token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Store the real file as /etc/cc-host-relay.env, owned by root, mode 0600.
# The following placeholder intentionally fails startup validation.
CC_HOST_ENROLL_TOKEN=REPLACE_WITH_A_RANDOM_32_BYTE_BASE64URL_TOKEN
CC_HOST_STATE=/var/lib/cc-host-relay/rooms.json
CC_HOST_BIND=127.0.0.1
CC_HOST_PORT=7865
